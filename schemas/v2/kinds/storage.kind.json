{
  "schema": "gridsim-kind/2",
  "kind": "storage",
  "title": "Energy storage (DC store and chemistry)",
  "description": "The energy store behind a converter: the v1 DC-source keys (DcSources.FromClass) and the scalar chemistry-preset parameters (BatteryChemistryLibrary). Omitted for want of a unit: cell capacity (Ah), resistances R0/R1/R2 (ohm), activation energies (J/mol), VMin/VMax (V), C-rate limits (1/h), self-discharge (per 30 days), cell mass (kg), specific heat (J/kg/K), passive cooling (W/K), calendar fade per sqrt(day): NOT DECLARED (finding for Mark): the closed unit vocabulary has no unit for these, so the parameter cannot be declared without inventing or misstating a unit. dcVoltageV was a unit gap until Q24 (2026-10) added V to the vocabulary; it is declared below.",
  "params": {
    "capacityMwh": {
      "type": "number",
      "unit": "MWh",
      "min": 0,
      "required": false,
      "description": "Usable energy (MWh) of the DC store behind the converter; 0 or absent = unbounded (no store).",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass: absent => 0 (no store)",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultCapacityMwh",
          "value": 0.0
        }
      ]
    },
    "socInit": {
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "required": false,
      "description": "Initial state of charge (fraction of capacityMwh).",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass: absent => 0.5",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultSocInit",
          "value": 0.5
        }
      ]
    },
    "socMin": {
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "required": false,
      "description": "Lower state-of-charge bound of the simple SoC bucket (used when no chemistry is set).",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass SocBucket: absent => 0",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultSocMin",
          "value": 0.0
        }
      ]
    },
    "socMax": {
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "required": false,
      "description": "Upper state-of-charge bound of the simple SoC bucket (used when no chemistry is set).",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass SocBucket: absent => 1",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultSocMax",
          "value": 1.0
        }
      ]
    },
    "batteryChemistry": {
      "type": "enum",
      "values": [
        "none",
        "LFP",
        "NMC",
        "LTO",
        "Na-ion",
        "VRFB",
        "Lead-acid"
      ],
      "required": false,
      "description": "Chemistry pack behind the converter. v1 stores a numeric code (0 or absent = none, 1 LFP, 2 NMC, 3 LTO, 4 Na-ion, 5 VRFB, 6 lead-acid; DcSources.ChemistryFromCode); v2 names it. No codeDefault: the v1 fallback is the numeric code 0, which is not one of these names.",
      "codeDefaults": []
    },
    "dcVoltageV": {
      "type": "number",
      "unit": "V",
      "min": 1,
      "max": 1500,
      "required": false,
      "description": "DC pack voltage (V) of the battery store, used by PackModel.Sized to set the series cell count (round(dcVoltageV / cell nominal voltage), at least 1). Only read when a chemistry is set. The 1500 V ceiling is the low-voltage DC limit that utility battery packs are built to.",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass: absent => 1000 V",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultDcVoltageV",
          "value": 1000.0
        }
      ]
    },
    "converterEfficiency": {
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "required": false,
      "description": "One-way converter efficiency between the chemistry pack and the grid.",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass: absent => 0.98",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultConverterEfficiency",
          "value": 0.98
        }
      ]
    },
    "ambientC": {
      "type": "number",
      "unit": "degC",
      "min": -60,
      "max": 80,
      "required": false,
      "description": "Ambient temperature of the chemistry pack (degC).",
      "codeDefaults": [
        {
          "consumer": "DcSources.FromClass: absent => 25 degC",
          "ref": "member:GridSim.Core:GridSim.Core.Assets.DcSources.DefaultAmbientC",
          "value": 25.0
        }
      ]
    },
    "cellSocMin": {
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "required": false,
