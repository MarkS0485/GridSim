    "settingsNominalHz": {
      "type": "number",
      "unit": "Hz",
      "min": 0,
      "required": false,
      "markGated": true,
      "description": "The system nominal frequency (Hz) the class's frequency settings (ufTripHz, ofTripHz, lfddStageHz) are written for. On a system at another nominal they move by the difference, as hertz offsets (N297, B4 October 2026; the FrequencyBands convention). Absent: 50 Hz, the GB convention of every bundled class. Each frequency setting must lie on its own side of it and within 10 Hz (N318, LF6 October 2026, replacing N304's symmetric 5 Hz bound): ufTripHz and lfddStageHz strictly below it, ofTripHz strictly above it; anything else is refused at load, naming the key. The side test catches native 60 Hz settings written without this key (a 60 Hz under-frequency stage then lies above 50 Hz); the 10 Hz admits every real setting, the widest being the Quebec Interconnection's +6.0 Hz instantaneous over-frequency trip (NERC PRC-024-3 Table 3).",
      "codeDefaults": [
        {
          "consumer": "ProtectionController: absent => AssetParamDefaults.ProtectionSettingsNominalHz (the GB 50 Hz)",
