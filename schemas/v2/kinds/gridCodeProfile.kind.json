{
  "schema": "gridsim-kind/2",
  "kind": "gridCodeProfile",
  "title": "Grid-code profile",
  "description": "Frequency and voltage limits of a grid code (GB today). Not bound from a case yet (the v2 loader refuses a case that names one).",
