      "type": "number",
      "unit": "Hz",
      "min": 0,
      "required": false,
      "markGated": true,
      "description": "Nominal system frequency (Hz).",
      "codeDefaults": [
        {
          "consumer": "SyntheticGb model frequency (the builder sets FrequencyHz = FrequencyLimits.NominalHz since R196 / D2); the same constant is FrequencyLimits.NominalHz itself, the frequency limits' nominal",
          "ref": "member:GridSim.Core:GridSim.Core.Dynamics.FrequencyLimits.NominalHz",
          "value": 50.0
        },
        {
          "consumer": "JSON system.json default (JsonDefaults.FrequencyHz)",
          "ref": "member:GridSim.Core:GridSim.Core.IO.Json.JsonDefaults.FrequencyHz",
          "value": 50.0
        },
        {
          "consumer": "Frequency model DynamicsConfig.NominalHz",
          "ref": "instance:GridSim.Core:GridSim.Core.Dynamics.DynamicsConfig.NominalHz",
          "value": 50.0
        },
        {
          "consumer": "RmsConverterParameters NominalHz record default",
          "ref": "param:GridSim.Core:GridSim.Core.Dynamics.Models.RmsConverterParameters:.ctor:NominalHz",
          "value": 50.0
        },
        {
