<Project Sdk="Microsoft.NET.Sdk">

  <!-- RC5 WP32: a contract 2 model plug-in (a machine and two relays) used by Rc5Wp32UserMachineRelayTests. It references
       GridSim.Core for the contract only (Private=false: Core is not copied beside it; the host's Core is the one the plug-in
       binds to). The test project does not reference it, so building the tests does not build it; the solution build does,
       and the tests read its DLL from bin/<Configuration>/net10.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GridSim.Core\GridSim.Core.csproj" Private="false" />
  </ItemGroup>

</Project>
