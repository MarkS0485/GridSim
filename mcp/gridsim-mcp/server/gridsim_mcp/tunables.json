{
  "schema": "gridsim-mcp-tunables/1",
  "title": "GridSim values a user may tune through the MCP server",
  "summary": "Runtime tuning uses only options GridSim already has (command-line flags of the verbs named). Nothing here changes GridSim's code. A tuned result is the user's own: it carries a TUNED marker and the tuned values, and a result tuned off a standard says which standard it no longer complies with. Physics is not tunable. Settings that protect the program's use limits are not tunable and are not listed.",
  "classes": {
    "PHYSICS": "Fixed. Constants, laws and per-unit definitions. Never tunable at run time or by a rebuild.",
    "STANDARD": "Tunable, but the value comes from a published standard. Every result made with a non-default value is flagged 'off-standard: <standard> no longer complied with'.",
    "NUMERICS": "Free within the stated safe range. A converged answer meets the same convergence test, so it agrees with the default answer to within that test, but it is not the same bits."
  },
  "tunables": [
    {
      "key": "pf.engine",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--engine",
      "type": "enum",
      "values": ["newton", "fdxb", "fdbx", "gs"],
      "default": "newton",
      "meaning": "Power-flow engine: Newton-Raphson, fast-decoupled XB or BX, or Gauss-Seidel. Every engine stops on the same power-mismatch test."
    },
    {
      "key": "pf.gs_accel",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--gs-accel",
      "type": "number",
      "unit": "1",
      "exclusive_min": 0,
      "exclusive_max": 2,
      "default": 1.0,
      "requires": {"pf.engine": "gs"},
      "meaning": "Gauss-Seidel acceleration factor. Only with pf.engine gs."
    },
    {
      "key": "pf.max_iter",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--max-iter",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 100000,
      "default": 100,
      "default_if": [{"when": {"pf.engine": "gs"}, "default": 10000}],
      "meaning": "Most iterations per Newton (or fast-decoupled, or Gauss-Seidel) pass. Each reactive-limit pass gets this budget again."
    },
    {
      "key": "pf.max_q_passes",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--max-q-passes",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 10000,
      "default": 100,
      "meaning": "Most reactive-limit (PV to PQ) switching passes."
    },
    {
      "key": "pf.q_revert",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--q-revert",
      "type": "boolean",
      "default": false,
      "meaning": "Let a bus switched to PQ return to PV once its limit is no longer binding (MATPOWER enforce_q_lims style). The loop settles in fewer passes on large cases."
    },
    {
      "key": "pf.diverge_limit",
      "class": "NUMERICS",
      "verbs": ["pf"],
      "flag": "--diverge-limit",
      "type": "number_or_off",
      "unit": "pu@system",
      "exclusive_min": 0,
      "max": 1000000,
      "default": 10.0,
      "meaning": "Divergence stop: a pass whose largest mismatch rises above this limit and above its starting mismatch stops with DIVERGED. 'off' runs every pass to the iteration cap. It reads the mismatch only, so a converging solve gives the same bits with any value."
    },
    {
      "key": "nminus1.batched_lanes",
      "class": "NUMERICS",
      "verbs": ["nminus1"],
      "flag": "--batched-lanes",
      "type": "integer",
      "unit": "1",
      "min": 0,
      "max": 1024,
      "default": null,
      "meaning": "Solve the branch outages with the batched contingency sweep on this many lanes (0: one per processor). Bit-identical to the default sequential screen; only the speed differs."
    },
    {
      "key": "cpf.step",
      "class": "NUMERICS",
      "verbs": ["cpf"],
      "flag": "--step",
      "type": "number",
      "unit": "1",
      "exclusive_min": 0,
      "max": 1.0,
      "default": 0.25,
      "meaning": "Initial load-multiplier (lambda) step of the continuation."
    },
    {
      "key": "cpf.min_step",
      "class": "NUMERICS",
      "verbs": ["cpf"],
      "flag": "--min-step",
      "type": "number",
      "unit": "1",
      "exclusive_min": 0,
      "max_key": "cpf.step",
      "max": 1.0,
      "default": 0.001,
      "meaning": "Bisection stops below this step: the nose is bracketed to it. At most cpf.step."
    },
    {
      "key": "cpf.max_steps",
      "class": "NUMERICS",
      "verbs": ["cpf"],
      "flag": "--max-steps",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 100000,
      "default": 200,
      "meaning": "Cap on power-flow solves of the continuation."
    },
    {
      "key": "acopf-full.max_iter",
      "class": "NUMERICS",
      "verbs": ["acopf-full"],
      "flag": "--max-iter",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 10000,
      "default": 150,
      "meaning": "Interior-point iteration cap (MIPS max_it)."
    },
    {
      "key": "scopf.max_rounds",
      "class": "NUMERICS",
      "verbs": ["scopf"],
      "flag": "--max-rounds",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 1000,
      "default": 50,
      "meaning": "Most LP solves constraint generation may take."
    },
    {
      "key": "scopf.full_lp",
      "class": "NUMERICS",
      "verbs": ["scopf"],
      "flag": "--full-lp",
      "type": "boolean",
      "default": false,
      "meaning": "Put every post-outage limit in the LP from the start instead of generating constraints. Same optimum, more work."
    },
    {
      "key": "restore.vmin",
      "class": "STANDARD",
      "verbs": ["restore"],
      "flag": "--vmin",
      "type": "number",
      "unit": "pu",
      "min": 0.5,
      "max": 1.0,
      "default": 0.9,
      "standard": "the statutory voltage band (VoltageLimits, 0.90-1.10 pu)",
      "meaning": "Lowest bus voltage an energisation step may reach."
    },
    {
      "key": "restore.vmax",
      "class": "STANDARD",
      "verbs": ["restore"],
      "flag": "--vmax",
      "type": "number",
      "unit": "pu",
      "min": 1.0,
      "max": 1.5,
      "min_key": "restore.vmin",
      "default": 1.1,
      "standard": "the statutory voltage band (VoltageLimits, 0.90-1.10 pu)",
      "meaning": "Highest bus voltage an energisation step may reach. Above restore.vmin."
    },
    {
      "key": "protection-check.uv",
      "class": "STANDARD",
      "verbs": ["protection-check"],
      "flag": "--uv",
      "type": "number",
      "unit": "pu",
      "min": 0.1,
      "max": 1.0,
      "default": 0.8,
      "standard": "ENA EREC G99 Issue 2 Table 10.1 (HV interface protection settings)",
      "meaning": "Under-voltage pickup."
    },
    {
      "key": "protection-check.ov",
      "class": "STANDARD",
      "verbs": ["protection-check"],
      "flag": "--ov",
      "type": "number",
      "unit": "pu",
      "min": 1.0,
      "max": 1.5,
      "default": 1.1,
      "standard": "ENA EREC G99 Issue 2 Table 10.1 (HV interface protection settings)",
      "meaning": "Over-voltage pickup."
    },
    {
      "key": "protection-check.uf",
      "class": "STANDARD",
      "verbs": ["protection-check"],
      "flag": "--uf",
      "type": "number",
      "unit": "Hz",
      "min": 40.0,
      "max": 65.0,
      "default": 47.5,
      "requires_also": "protection-check.of",
      "standard": "ENA EREC G99 frequency protection settings for a 50 Hz system",
      "meaning": "Under-frequency pickup. Give it with protection-check.of: the pair is taken as written for the case's own nominal frequency."
    },
    {
      "key": "protection-check.of",
      "class": "STANDARD",
      "verbs": ["protection-check"],
      "flag": "--of",
      "type": "number",
      "unit": "Hz",
      "min": 40.0,
      "max": 65.0,
      "min_key": "protection-check.uf",
      "default": 52.0,
      "requires_also": "protection-check.uf",
      "standard": "ENA EREC G99 frequency protection settings for a 50 Hz system",
      "meaning": "Over-frequency pickup. Give it with protection-check.uf; above it."
    },
    {
      "key": "harmonics.synth_spectrum",
      "class": "STANDARD",
      "verbs": ["harmonics"],
      "flag": "--synth-spectrum",
      "type": "enum",
      "values": ["g5", "ideal"],
      "default": "g5",
      "standard": "ENA EREC G5 Issue 5 Table B.3 six-pulse profile",
      "meaning": "Spectrum of the synthetic six-pulse source: the cited G5 profile, or the idealised 1/h spectrum."
    }
  ],
  "fixed": [
    {"name": "Physical laws checked by physics-check (energy conservation, Ohm's law, KCL, complex power, ...)", "class": "PHYSICS"},
    {"name": "Per-unit definitions and bases (system MVA base, bus kV bases)", "class": "PHYSICS"},
    {"name": "Physical constants (permeability of free space, pi, the fdlibm reference constants)", "class": "PHYSICS"},
    {"name": "The case's nominal frequency (--frequency-hz states a .m file's frequency: it is data, not tuning)", "class": "PHYSICS"},
    {"name": "IEC 60909-0 voltage factor c (Table 1) and the K_T constants 0.95 and 0.6", "class": "STANDARD", "note": "No run-time option sets them; they live in Core and are not on the rebuild list."}
  ],
  "compile_time": [
    {"symbol": "PowerFlowOptions.Tolerance (default)", "file": "src/GridSim.Core/PowerFlow/PowerFlowOptions.cs", "value": 1e-08, "unit": "pu@system", "class": "NUMERICS", "rebuild": true},
    {"symbol": "PowerFlowOptions.MaxTolerance", "file": "src/GridSim.Core/PowerFlow/PowerFlowOptions.cs", "value": 0.01, "unit": "pu@system", "class": "NUMERICS", "rebuild": false},
    {"symbol": "NewtonShell.QLimitTolMva", "file": "src/GridSim.Core/PowerFlow/NewtonShell.cs", "value": 0.001, "unit": "MVA", "class": "NUMERICS", "rebuild": false},
    {"symbol": "NewtonShell.RevertVoltTolPu", "file": "src/GridSim.Core/PowerFlow/NewtonShell.cs", "value": 0.0001, "unit": "pu", "class": "NUMERICS", "rebuild": false},
    {"symbol": "NewtonShell.MaxUndampedStep", "file": "src/GridSim.Core/PowerFlow/NewtonShell.cs", "value": 0.4, "unit": "1", "class": "NUMERICS", "rebuild": false},
    {"symbol": "NewtonShell.VmFloorPu", "file": "src/GridSim.Core/PowerFlow/NewtonShell.cs", "value": 0.01, "unit": "pu", "class": "NUMERICS", "rebuild": false},
    {"symbol": "NewtonShell.MaxRetryBranchAngleDeg", "file": "src/GridSim.Core/PowerFlow/NewtonShell.cs", "value": 90.0, "unit": "deg", "class": "NUMERICS", "rebuild": false},
    {"symbol": "SteadyStateSolver.DefaultMaxOltcPasses", "file": "src/GridSim.Core/PowerFlow/SteadyStateSolver.cs", "value": 25, "unit": "1", "class": "NUMERICS", "rebuild": false},
    {"symbol": "SolverSelector.DenseSparseCrossoverBuses", "file": "src/GridSim.Core/PowerFlow/SolverSelector.cs", "value": 200, "unit": "buses", "class": "NUMERICS", "rebuild": false},
    {"symbol": "DistributedSlackPowerFlow.ToleranceMw", "file": "src/GridSim.Core/PowerFlow/DistributedSlackPowerFlow.cs", "value": 0.0001, "unit": "MW", "class": "NUMERICS", "rebuild": false},
    {"symbol": "LccDcLinks.CouplingTolerance", "file": "src/GridSim.Core/PowerFlow/LccDcLinks.cs", "value": 1e-09, "unit": "1", "class": "NUMERICS", "rebuild": false},
    {"symbol": "Iec60909.VoltageFactor (c max 1.10 / 1.05, c min 1.00 / 0.95)", "file": "src/GridSim.Core/Protection/ShortCircuit/Iec60909.cs", "value": 1.1, "unit": "1", "class": "STANDARD", "rebuild": false},
    {"symbol": "Iec60909.MeshedPeakSafetyFactor", "file": "src/GridSim.Core/Protection/ShortCircuit/Iec60909.cs", "value": 1.15, "unit": "1", "class": "STANDARD", "rebuild": false},
    {"symbol": "VoltageLimits.OperationalLowPu / OperationalHighPu", "file": "src/GridSim.Core/Analysis/VoltageLimits.cs", "value": 0.94, "unit": "pu", "class": "STANDARD", "rebuild": false},
    {"symbol": "VoltageLimits.StatutoryLowPu / StatutoryHighPu", "file": "src/GridSim.Core/Analysis/VoltageLimits.cs", "value": 0.9, "unit": "pu", "class": "STANDARD", "rebuild": false},
    {"symbol": "EarthReturn.Mu0", "file": "src/GridSim.Core/Lines/EarthReturn.cs", "value": 1.2566370614359173e-06, "unit": "H/m", "class": "PHYSICS", "rebuild": false},
    {"symbol": "CliDefaults.RmsStepS", "file": "src/GridSim.Cli/CliDefaults.cs", "value": 0.005, "unit": "s", "class": "NUMERICS", "rebuild": true},
    {"symbol": "CliDefaults.ClassicalStepS", "file": "src/GridSim.Cli/CliDefaults.cs", "value": 0.002, "unit": "s", "class": "NUMERICS", "rebuild": true}
  ],
  "rebuild_allowlist": [
    {
      "symbol": "PowerFlowOptions.DefaultTolerance",
      "file": "src/GridSim.Core/PowerFlow/PowerFlowOptions.cs",
      "pattern": "private readonly double _tolerance = (?P<value>[0-9.eE+-]+);",
      "default": 1e-08,
      "min": 1e-12,
      "max": 1e-06,
      "unit": "pu@system",
      "class": "NUMERICS",
      "meaning": "The default power-mismatch convergence tolerance of every power flow."
    },
    {
      "symbol": "CliDefaults.RmsStepS",
      "file": "src/GridSim.Cli/CliDefaults.cs",
      "pattern": "public const double RmsStepS = (?P<value>[0-9.eE+-]+),",
      "default": 0.005,
      "min": 0.0005,
      "max": 0.01,
      "unit": "s",
      "class": "NUMERICS",
      "meaning": "Integration step of the RMS single-clearing stability study."
    },
    {
      "symbol": "CliDefaults.ClassicalStepS",
      "file": "src/GridSim.Cli/CliDefaults.cs",
      "pattern": "public const double ClassicalStepS = (?P<value>[0-9.eE+-]+),",
      "default": 0.002,
      "min": 0.0002,
      "max": 0.01,
      "unit": "s",
      "class": "NUMERICS",
      "meaning": "RK4 step of the classical single-clearing stability study."
    }
  ]
}
