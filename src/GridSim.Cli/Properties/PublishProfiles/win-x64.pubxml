<?xml version="1.0" encoding="utf-8"?>
<!-- F04: release publish profile for the gridsim command line tool, Windows x64.

     Use:  dotnet publish src/GridSim.Cli -c Release -p:PublishProfile=win-x64
     Out:  artifacts/publish/gridsim-win-x64/   (artifacts/ is ignored by source control)

     The three CLI profiles (win-x64, linux-x64, osx-arm64) are identical apart from the runtime identifier.

     What it produces: ONE self-contained executable (gridsim.exe here; gridsim on Linux and macOS) that carries the
     .NET runtime, so the target machine needs no .NET install, plus the bundled data/ and schemas/ folders,
     LICENSE.md and THIRD-PARTY-NOTICES.md beside it. The case data stays as loose files next to the binary on purpose:
     users edit and add cases there, and the CLI finds them through AppContext.BaseDirectory exactly as in a normal
     build.

     Deliberately OFF, with the reason:
       PublishTrimmed     the JSON loaders and the analysis registry use reflection; trimming could remove code that
                          is only reached at run time, and a trimmed binary would no longer be the build the test
                          suite verified.
       PublishReadyToRun  ReadyToRun pre-compiles methods ahead of time for a baseline instruction set, and the JIT
                          then re-compiles the hot ones while the program runs. GridSim's contract is bit-identical
                          numbers across runs and CPU tiers, proved by the test suite under the normal JIT; a second
                          code-generation path for the numeric kernels is not worth a faster start-up.
     IncludeNativeLibrariesForSelfExtract: the single-file bundle extracts any native library to a temporary folder on
     first run, so native interop resolves as it does in a normal build. The GPU vendor runtimes themselves (ROCm,
     OpenCL, CUDA) are never bundled; they come from the machine. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\gridsim-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
