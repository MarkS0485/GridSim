<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="using:GridSim.App.Tabs"
             xmlns:cy="using:GridSim.Ui.Tabs.Cycle"
             x:Class="GridSim.App.Tabs.CycleView"
             x:DataType="cy:CycleModel">
  <!-- UI programme Phase 1.6: the CYCLE tab, a port of src/GridSim.Wpf/Views/CycleView.xaml. Same texts, same layout
       order (the High-tier hero and utilisation; the budget summary beside this cycle's jobs; the explainer), the same
       literal colours, and every token colour from the shared CycleModel through TokenBrush (the bytes WPF shows). The
       DataContext is the shared CycleModel. -->
  <Grid Margin="10" RowDefinitions="Auto,*,Auto">

    <!-- ============ hero: High-tier guarantee + utilization ============ -->
    <Border Grid.Row="0" Classes="Card" Padding="18,14" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="HeroText" Text="{Binding Hero}" FontSize="30" FontWeight="Bold"
                     Foreground="{Binding HeroColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
          <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Classes="Label" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="UTILIZATION" Classes="Label" HorizontalAlignment="Right" />
          <TextBlock x:Name="UtilText" Text="{Binding Util}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"
                     Foreground="{Binding HeroColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ summary + jobs ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*">

      <!-- summary -->
      <Border Grid.Column="0" Classes="Card" Padding="16,12" Margin="0,0,6,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock x:Name="CycleHeaderText" Classes="PanelHeader">
            <Run Text="CYCLE " /><Run Text="{Binding CycleIndex}" /><Run Text="  -  budget accounting" />
          </TextBlock>

          <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="BaseSolveText" Text="{Binding BaseSolve}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
            <TextBlock Text="Base solve (single core)" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WallText" Text="{Binding Wall}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
            <TextBlock Text="Fan-out wall time" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="ComputeText" Text="{Binding Compute}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
            <TextBlock Text="Compute spent (core-s)" Classes="Label" />
          </DockPanel>

          <Border Height="1" Background="#1E2733" Margin="0,12" />

          <DockPanel Margin="0,0,0,0">
            <TextBlock x:Name="HighText" Text="{Binding High}" DockPanel.Dock="Right" FontWeight="SemiBold"
                       Foreground="{Binding HighColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
            <TextBlock Text="High tier" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="LowText" Text="{Binding Low}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
            <TextBlock Text="Low tier (done / admitted / deferred)" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="CancelledText" Text="{Binding Cancelled}" DockPanel.Dock="Right" Foreground="#F3C13A" FontWeight="SemiBold" />
            <TextBlock Text="Low cancelled at deadline" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="BacklogText" Text="{Binding Backlog}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
            <TextBlock Text="Backlog depth" Classes="Label" />
          </DockPanel>

          <Border Height="1" Background="#1E2733" Margin="0,12" />

          <DockPanel Margin="0,0,0,0">
            <TextBlock x:Name="CoverageText" Text="{Binding Coverage}" DockPanel.Dock="Right" FontWeight="SemiBold"
                       Foreground="{Binding CoverageColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
            <!-- D-DOC-144: cumulative since the model was loaded (it never falls), so not "rolling". -->
            <TextBlock Text="N-1 shards covered since load" Classes="Label" />
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WorstText" Text="{Binding Worst}" DockPanel.Dock="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{Binding WorstColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
            <TextBlock Text="Worst contingency seen" Classes="Label" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- jobs -->
      <Border Grid.Column="1" Classes="Card" Padding="16,12" Margin="6,0,0,0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="JOBS THIS CYCLE  -  HIGH FIRST, HEAVIEST FIRST" Classes="PanelHeader" />
          <ItemsControl x:Name="JobList" ItemsSource="{Binding Jobs}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cy:CycleJobRowModel">
                <Grid Margin="0,3" ColumnDefinitions="44,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Priority}" FontWeight="SemiBold" FontSize="11"
                             Foreground="{Binding PriorityColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#C9D4DF" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Outcome}" FontWeight="SemiBold" Margin="12,0,0,0"
                             Foreground="{Binding OutcomeColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============ explainer ============ -->
    <TextBlock Grid.Row="2" Margin="2,10,2,0" Foreground="#8A97A6" FontSize="12" TextWrapping="Wrap"
               Text="The Newton-Raphson base solve is single-core; once it converges its immutable frame is shared to every downstream analysis and run across a worker pool. High jobs (hot N-1, harmonics, watch list) complete every cycle; Low jobs (rotating N-1 shards, RoCoF, conformance) run best-effort within the compute budget (workers x window) and rotate to full N-1 coverage over several cycles. Compute budget is measured in core-milliseconds, so it scales with core count." />
  </Grid>
</UserControl>
