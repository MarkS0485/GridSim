<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="using:GridSim.App.Tabs"
             xmlns:dm="using:GridSim.Ui.Tabs.Domains"
             x:Class="GridSim.App.Tabs.DomainsView"
             x:DataType="dm:DomainsModel">
  <!-- UI programme Phase 1.6: the SPEED DOMAINS tab, a port of src/GridSim.Wpf/Views/DomainsView.xaml. Same texts, same
       layout order (dominance summary; the GVad bar chart; the spinning-inertia bar chart; the per-domain cards), the
       same literal colours, and every token colour from the shared DomainsModel through TokenBrush (the bytes WPF
       shows). The DataContext is the shared DomainsModel; it is computed only while this tab is showing (Active). -->
  <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*">

    <!-- ============ dominance summary ============ -->
    <Border Grid.Row="0" Classes="Card" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="SPEED DOMAINS" Classes="PanelHeader" />
        <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="Label" Margin="0,4,0,12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,44,0">
            <TextBlock Text="DOMAINS" Classes="Label" />
            <TextBlock x:Name="DomainCountText" Text="{Binding DomainCount}" Classes="Value" FontSize="28" />
          </StackPanel>
          <StackPanel Margin="0,0,44,0">
            <TextBlock Text="&#916;GVa (DOMINANCE)" Classes="Label" />
            <TextBlock x:Name="DeltaGvaText" Text="{Binding DeltaGva}" Classes="Value" FontSize="28"
                       Foreground="{Binding DominantColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DOMINANT DOMAIN" Classes="Label" />
            <TextBlock x:Name="DominantText" Text="{Binding Dominant}"
                       Foreground="{Binding DominantColour, Converter={x:Static tabs:TokenBrush.Instance}}"
                       FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ProvenanceText" Text="{Binding Provenance}" Foreground="#F3C13A" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ============ GVad dominance bar chart (hero) ============ -->
    <Border Grid.Row="1" Classes="Card" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="GVad DOMINANCE  *  apparent-power stiffness &#931;(S&#183;C) per speed domain" Classes="PanelHeader" />
        <ItemsControl x:Name="GvadBars" ItemsSource="{Binding Domains}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dm:SpeedDomainRowModel">
              <Grid Margin="0,4" ColumnDefinitions="210,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Speed}" Classes="Label" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="{Binding BarWidth}" Height="22" CornerRadius="3"
                          Background="{Binding AccentColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
                  <TextBlock Text="{Binding GvadGva}" Foreground="#C9D4DF" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DominantTag}" Foreground="#2FD27F" FontWeight="Bold" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="GapText" Text="{Binding Gap}" Foreground="#8A97A6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ============ spinning-inertia bar chart ============ -->
    <Border Grid.Row="2" Classes="Card" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="SPINNING INERTIA  *  real stored kinetic energy (GVA&#183;s) per domain" Classes="PanelHeader" />
        <ItemsControl x:Name="InertiaBars" ItemsSource="{Binding Domains}" Margin="0,10,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="dm:SpeedDomainRowModel">
              <Grid Margin="0,4" ColumnDefinitions="210,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Kind}" Classes="Label" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="{Binding InertiaBarWidth}" Height="22" CornerRadius="3"
                          Background="{Binding AccentColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
                  <TextBlock Text="{Binding InertiaLabel}" Foreground="#C9D4DF" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Apparent-power stiffness is split evenly, but REAL rotational inertia sits almost entirely in the synchronous thermal domain - inverters carry GVad but no spinning energy. This is what a lumped scalar hides."
                   Foreground="#8A97A6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ============ per-domain detail cards ============ -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="DomainCards" ItemsSource="{Binding Domains}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dm:SpeedDomainRowModel">
            <Border Classes="Card" Width="264" Margin="0,0,12,12" Padding="14">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{Binding DominantTag}" DockPanel.Dock="Right" Foreground="#2FD27F" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                  <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center"
                          Background="{Binding AccentColour, Converter={x:Static tabs:TokenBrush.Instance}}" />
                  <TextBlock Text="{Binding Name}" Classes="Value" FontSize="18" />
                </DockPanel>
                <TextBlock Text="{Binding Speed}" Classes="Label" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Kind}" Classes="Label" />
                <TextBlock Text="{Binding Machines}" Classes="Label" />
                <Border Height="1" Background="#1E2733" Margin="0,10" />
                <TextBlock Text="{Binding GvadGva}" Foreground="#3FA9F5" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding InertiaGvaS}" Foreground="#8A97A6" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
