<?xml version="1.0" encoding="utf-8"?>
<!-- F04: release publish profile for the GridSim desktop app (WPF, Windows only).

     Use:  dotnet publish src/GridSim.Wpf -c Release -p:PublishProfile=win-x64
     Out:  artifacts/publish/gridsim-desktop-win-x64/   (artifacts/ is ignored by source control)

     One self-contained GridSim.Wpf.exe that carries the .NET and Windows Desktop runtimes (no install needed), with
     the bundled data/ models, LICENSE.md and THIRD-PARTY-NOTICES.md beside it. WPF needs a few native libraries
     (for example the WPF graphics stack); IncludeNativeLibrariesForSelfExtract puts them inside the one executable,
     which extracts them to a temporary folder on first run. Trimming is not supported for WPF and ReadyToRun is off
     for the same reason as the CLI profiles. No installer yet: MSIX / WiX packaging and code signing are F13, held
     for the ship-scope decision (F25). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\gridsim-desktop-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
