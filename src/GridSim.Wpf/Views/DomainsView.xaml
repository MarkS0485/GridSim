<UserControl x:Class="GridSim.Wpf.Views.DomainsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" DataContext="{Binding Domains}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ dominance summary ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SPEED DOMAINS" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" Margin="0,4,0,12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="DOMAINS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding DomainCount}" Style="{StaticResource Value}" FontSize="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="&#916;GVa (DOMINANCE)" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding DeltaGva}" Style="{StaticResource Value}" FontSize="28" Foreground="{Binding DominantBrush}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DOMINANT DOMAIN" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Dominant}" Foreground="{Binding DominantBrush}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Provenance}" Foreground="#F3C13A" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ GVad dominance bar chart (hero) ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GVad DOMINANCE  *  apparent-power stiffness &#931;(S&#183;C) per speed domain" Style="{StaticResource PanelHeader}" />
                <ItemsControl ItemsSource="{Binding Domains}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Speed}" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="{Binding BarWidth}" Height="22" Background="{Binding Accent}" CornerRadius="3" />
                                    <TextBlock Text="{Binding GvadGva}" Foreground="#C9D4DF" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DominantTag}" Foreground="#2FD27F" FontWeight="Bold" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Gap}" Foreground="#8A97A6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ spinning-inertia bar chart ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SPINNING INERTIA  *  real stored kinetic energy (GVA&#183;s) per domain" Style="{StaticResource PanelHeader}" />
                <ItemsControl ItemsSource="{Binding Domains}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Label}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="{Binding InertiaBarWidth}" Height="22" Background="{Binding Accent}" CornerRadius="3" />
                                    <TextBlock Text="{Binding InertiaLabel}" Foreground="#C9D4DF" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Apparent-power stiffness is split evenly, but REAL rotational inertia sits almost entirely in the synchronous thermal domain - inverters carry GVad but no spinning energy. This is what a lumped scalar hides."
                           Foreground="#8A97A6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ per-domain detail cards ============ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Domains}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="264" Margin="0,0,12,12" Padding="14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding DominantTag}" DockPanel.Dock="Right" Foreground="#2FD27F" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Accent}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontSize="18" />
                                </DockPanel>
                                <TextBlock Text="{Binding Speed}" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding Machines}" Style="{StaticResource Label}" />
                                <Border Height="1" Background="#1E2733" Margin="0,10" />
                                <TextBlock Text="{Binding GvadGva}" Foreground="#3FA9F5" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InertiaGvaS}" Foreground="#8A97A6" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
