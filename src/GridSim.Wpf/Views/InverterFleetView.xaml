<UserControl x:Class="GridSim.Wpf.Views.InverterFleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" DataContext="{Binding InverterFleet}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ fleet summary ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="INVERTER FLEET  *  authored sample&#8594;compute&#8594;actuate dynamics" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" Margin="0,4,0,12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="NET FLEET RESPONSE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding NetFleetMw}" Style="{StaticResource Value}" FontSize="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="CLASSES" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ClassCount}" Style="{StaticResource Value}" FontSize="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="BOUND UNITS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TotalUnits}" Style="{StaticResource Value}" FontSize="28" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TRIPPED (LoM)" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TotalTripped}" Style="{StaticResource Value}" FontSize="28" Foreground="{Binding TrippedBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding LomWarning}" Foreground="#F5615C" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Provenance}" Foreground="#F3C13A" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ per-class table ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="PER-CLASS RESPONSE" Style="{StaticResource PanelHeader}" />
                <Grid Margin="0,10,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CLASS" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="1" Text="MODE" Style="{StaticResource Label}" />
                    <TextBlock Grid.Column="2" Text="UNITS" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="ONLINE MW" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="TRIPPED" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="SoC" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Classes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ClassName}" Foreground="#C9D4DF" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Mode}" Foreground="{Binding ModeBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#C9D4DF" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding OnlineMw}" Foreground="#C9D4DF" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding Tripped}" Foreground="{Binding TrippedBrush}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{Binding Soc}" Foreground="#8A97A6" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Grid-forming units inject synthetic inertia (power &#8733; df/dt) and ride through; grid-following units droop on measured local frequency and trip on RoCoF/vector-shift."
                           Foreground="#8A97A6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
