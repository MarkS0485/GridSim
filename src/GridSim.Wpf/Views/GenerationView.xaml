<UserControl x:Class="GridSim.Wpf.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:GridSim.Wpf.Visuals">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- headline metric strip -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="TOTAL GENERATION" Style="{StaticResource PanelHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding GenTotal}" Style="{StaticResource Value}" />
                        <TextBlock Text=" GW" Style="{StaticResource Unit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="SYSTEM INERTIA" Style="{StaticResource PanelHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding InertiaGva}" Style="{StaticResource Value}" />
                        <TextBlock Text=" GVAs" Style="{StaticResource Unit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="SYNCHRONOUS SHARE" Style="{StaticResource PanelHeader}" />
                    <TextBlock Text="{Binding SyncShare}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="EST. CO2" Style="{StaticResource PanelHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Co2}" Style="{StaticResource Value}" />
                        <TextBlock Text=" tCO2/h" Style="{StaticResource Unit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- fuel mix + import links -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- generation mix (left) + inertia by class (right)  -  same fuel ordering -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="GENERATION MIX BY FUEL" Style="{StaticResource PanelHeader}" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FuelMix}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{Binding Color}"
                                                           Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding Pct}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <Border Width="150" Height="7" Background="{StaticResource Track}" CornerRadius="3"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <Border Width="{Binding BarWidth}" Height="7" Background="{Binding Color}"
                                                                CornerRadius="3" HorizontalAlignment="Left" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Mw}" Grid.Column="2" VerticalAlignment="Center"
                                                           FontWeight="Bold" Margin="10,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="INERTIA BY CLASS" Style="{StaticResource PanelHeader}" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FuelMix}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{Binding Color}"
                                                           Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding InertiaGva}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <Border Width="150" Height="7" Background="{StaticResource Track}" CornerRadius="3"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <Border Width="{Binding InertiaBar}" Height="7" Background="{Binding Color}"
                                                                CornerRadius="3" HorizontalAlignment="Left" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- import links: every interconnector individually, signed flow against link capacity -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,10,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="IMPORT LINKS  INTERCONNECTORS" Style="{StaticResource PanelHeader}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding NetImport}" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ImportLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5,14,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left" />
                                                <Border Background="{StaticResource Track}" CornerRadius="7" Padding="6,1" Margin="8,0,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding BadgeBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Route}" Style="{StaticResource Label}" FontSize="10" />
                                            <!-- centred diverging bar: export pulls left, import pulls right -->
                                            <Grid Width="210" Height="8" HorizontalAlignment="Left" Margin="0,3,0,0">
                                                <Border Background="{StaticResource Track}" CornerRadius="3" />
                                                <Canvas>
                                                    <Line X1="105" Y1="0" X2="105" Y2="8" Stroke="{StaticResource Muted}"
                                                          StrokeThickness="1" Opacity="0.6" />
                                                    <Border Canvas.Left="{Binding BarOffset}" Width="{Binding BarWidth}" Height="8"
                                                            Background="{Binding Bar}" CornerRadius="3" />
                                                </Canvas>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Flow}" FontWeight="Bold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Capacity}" Style="{StaticResource Label}" FontSize="10"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- rotating machine + stability -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="THE GRID AS ONE MACHINE" Style="{StaticResource PanelHeader}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Same geometry as the frequency dial: a 240 degree track (the needle's +/-120 degrees at
                                 full scale) about the pivot (75,62), green band +/-24 degrees (0.1 Hz of the 0.5 Hz scale). -->
                            <Grid Width="150" Height="92" Grid.Column="0">
                                <Path Stroke="#2A3742" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 29.967,88 A 52,52 0 1 1 120.033,88" />
                                <Path Stroke="{StaticResource Green}" StrokeThickness="8" Opacity="0.55"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 53.850,14.496 A 52,52 0 0 1 96.150,14.496" />
                                <Canvas>
                                    <Line X1="75" Y1="62" X2="75" Y2="16" StrokeThickness="3"
                                          Stroke="{StaticResource Accent}" StrokeStartLineCap="Round">
                                        <Line.RenderTransform>
                                            <RotateTransform CenterX="75" CenterY="62" Angle="{Binding RpmAngle}" />
                                        </Line.RenderTransform>
                                    </Line>
                                    <Ellipse Canvas.Left="69" Canvas.Top="56" Width="12" Height="12" Fill="{StaticResource Text}" />
                                </Canvas>
                                <!-- N273: the dial's ends about the case's own nominal ("2970" / "3030" at 50 Hz). -->
                                <TextBlock Text="{Binding RpmDialLowText}" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding RpmDialHighText}" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Rpm}" Style="{StaticResource Value}" />
                                    <TextBlock Text=" RPM" Style="{StaticResource Unit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </StackPanel>
                                <TextBlock Text="{Binding Torque, StringFormat={}{0} MNm torque}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="SYNCHRONOUS vs CONVERTER" Style="{StaticResource PanelHeader}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Synchronous" Style="{StaticResource Label}" DockPanel.Dock="Left" Width="92" />
                            <TextBlock Text="{Binding SyncMw}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Height="7" Background="{StaticResource Track}" CornerRadius="3" HorizontalAlignment="Left" Width="210" Margin="0,2,0,6">
                            <Border Width="{Binding SyncBar}" Height="7" Background="{StaticResource Green}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Border>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Converter" Style="{StaticResource Label}" DockPanel.Dock="Left" Width="92" />
                            <TextBlock Text="{Binding ConverterMw}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Height="7" Background="{StaticResource Track}" CornerRadius="3" HorizontalAlignment="Left" Width="210" Margin="0,2,0,0">
                            <Border Width="{Binding ConverterBar}" Height="7" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Border>

                        <!-- the whole, made of both halves  -  see what composes the total at a glance -->
                        <DockPanel Margin="0,10,0,2">
                            <TextBlock Text="Total mix" Style="{StaticResource Label}" DockPanel.Dock="Left" Width="92" />
                            <TextBlock Text="{Binding GenTotal, StringFormat={}{0} GW}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Height="11" Background="{StaticResource Track}" CornerRadius="3" HorizontalAlignment="Left" Width="210">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{Binding SyncBar}" Height="11" Background="{StaticResource Green}" CornerRadius="3,0,0,3" />
                                <Border Width="{Binding ConverterBar}" Height="11" Background="{StaticResource Accent}" CornerRadius="0,3,3,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="one whole  -  green spinning iron + cyan converter" Style="{StaticResource Label}"
                                   FontSize="{StaticResource MicroFontSize}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FOSSIL" Style="{StaticResource PanelHeader}" Foreground="{StaticResource Amber}" />
                            <TextBlock Text="{Binding FossilMw}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RENEWABLE" Style="{StaticResource PanelHeader}" Foreground="{StaticResource Green}" />
                            <TextBlock Text="{Binding RenewableMw}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Background="{StaticResource PanelHi}">
                    <StackPanel>
                        <TextBlock Text="STABILITY REGIME" Style="{StaticResource PanelHeader}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="12" Height="12" Fill="{Binding StabilityBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StabilityNote}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Synchronous plant carries inertia; as it retires, RoCoF after a trip worsens. The TSGB device targets the gas held purely for that margin."
                                   Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="TSGB DEVICE" Style="{StaticResource PanelHeader}" />
                        <TextBlock Text="synthetic inertia + fast frequency response" Style="{StaticResource Label}" Margin="0,1,0,8" />

                        <DockPanel>
                            <TextBlock Text="{Binding TsgbInertiaGva, StringFormat={}{0:F0} GVAs}" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Synthetic inertia" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="150" Value="{Binding TsgbInertiaGva, Mode=TwoWay}" Margin="0,2,0,8" />

                        <DockPanel>
                            <TextBlock Text="{Binding TsgbFfrGw, StringFormat={}{0:F1} GW}" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Text="Fast response" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="10" Value="{Binding TsgbFfrGw, Mode=TwoWay}" Margin="0,2,0,10" />

                        <Button Content="SIMULATE LARGEST-UNIT TRIP" Style="{StaticResource FlatBtn}"
                                HorizontalAlignment="Stretch" Click="Trip_Click" />
                        <TextBlock Text="{Binding TripBaseline}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TripTsgb}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TripVerdict}" FontWeight="Bold" Foreground="{Binding TripVerdictBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <!-- frequency-response trace: baseline vs +TSGB against the GB limits -->
                        <viz:FrequencyTrace x:Name="FreqTrace" Height="150" Margin="0,10,0,0" />

                        <TextBlock Text="{Binding TripAssessment}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TripSizing}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
