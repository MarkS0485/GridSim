<UserControl x:Class="GridSim.Wpf.Views.HumanScaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding HumanScale}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- hero claim + absurd facts -->
                <RowDefinition Height="Auto" />   <!-- THE TWIST -->
                <RowDefinition Height="Auto" />   <!-- the grand engine -->
                <RowDefinition Height="Auto" />   <!-- regenerative braking -->
                <RowDefinition Height="Auto" />   <!-- things you can hold -->
            </Grid.RowDefinitions>

            <!-- ============ hero claim + absurd-but-true facts ============ -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14"
                    Background="{StaticResource PanelHi}">
                <StackPanel>
                    <DockPanel>
                        <Border Background="{StaticResource Track}" CornerRadius="7" Padding="7,2"
                                HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <TextBlock Text="JUST FOR FUN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="BRITAIN'S SINGLE LARGEST ENGINE" Style="{StaticResource PanelHeader}" FontSize="13" />
                    </DockPanel>

                    <!-- the headline number -->
                    <TextBlock Text="{Binding HeroValue}" FontSize="52" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HeroLine}" Style="{StaticResource Label}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,2,0,0" />

                    <!-- the absurd-but-true run -->
                    <TextBlock Text="ABSURD, BUT TRUE" Style="{StaticResource PanelHeader}" FontSize="11" Margin="0,14,0,4" />
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" x:Key="FactLine">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Style>
                        </StackPanel.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource Accent}" Margin="0,8,9,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Fact1}" Style="{StaticResource FactLine}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource Accent}" Margin="0,8,9,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Fact2}" Style="{StaticResource FactLine}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource Accent}" Margin="0,8,9,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Fact3}" Style="{StaticResource FactLine}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource Accent}" Margin="0,8,9,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Fact4}" Style="{StaticResource FactLine}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource Accent}" Margin="0,8,9,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Fact5}" Style="{StaticResource FactLine}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ THE TWIST  -  the only reading here with physics behind it ============ -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,14">
                <StackPanel>
                    <DockPanel>
                        <Border Background="{StaticResource Track}" CornerRadius="7" Padding="7,2"
                                HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <TextBlock Text="THIS ONE IS REAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Green}" />
                        </Border>
                        <TextBlock Text="THE TWIST  -  the crankshaft is 1,000 km of torsion bar" Style="{StaticResource PanelHeader}" FontSize="13" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="The shaft isn't rigid. Scotland's rotors run permanently ahead of London's, by tens of degrees, and that wind-up IS the transmission: power south = (V1.V2 / X).sin(delta). Slacken the angle and the flow stops. For the 3,000-rpm two-pole sets, electrical degrees are mechanical degrees - this is a real rotor twist, measured off your own solve." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />   <!-- headline + regions -->
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />      <!-- ranked machines -->
                        </Grid.ColumnDefinitions>

                        <!-- headline wind-up + regional gauge -->
                        <StackPanel Grid.Column="0" Width="420">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TwistTotal}" FontSize="46" FontWeight="Bold" Foreground="{Binding TwistBrush}" />
                                <TextBlock Text="end to end" Style="{StaticResource Unit}" VerticalAlignment="Bottom" Margin="8,0,0,10" />
                            </StackPanel>
                            <TextBlock Text="{Binding TwistToSlip}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" />
                            <!-- distance-to-wall bar: fills toward the 90-degree redline (230px track) -->
                            <Grid Width="230" Height="10" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <Border Background="{StaticResource Track}" CornerRadius="5" />
                                <Border Width="{Binding TwistBarPx}" Height="10" Background="{Binding TwistBrush}"
                                        CornerRadius="5" HorizontalAlignment="Left" />
                                <Rectangle Width="2" Fill="{StaticResource Red}" HorizontalAlignment="Right" ToolTip="90 deg - pole slip" />
                            </Grid>
                            <DockPanel Width="230" HorizontalAlignment="Left" Margin="0,2,0,0">
                                <TextBlock Text="0 deg" Style="{StaticResource Label}" FontSize="9" DockPanel.Dock="Left" />
                                <TextBlock Text="redline 90 deg" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Text="ROTOR LEAD BY REGION  vs THE SOUTH" Style="{StaticResource PanelHeader}" FontSize="11" Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding Regions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Width="150" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DegText}" FontWeight="Bold" FontSize="15" Width="84" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Height="8" Width="230" Background="{StaticResource Track}" CornerRadius="4" HorizontalAlignment="Left">
                                                    <Border Width="{Binding BarWidth}" Height="8" Background="{Binding Bar}" CornerRadius="4" HorizontalAlignment="Left" />
                                                </Border>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" FontSize="9" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding TwistCorridor}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- ranked synchronous machines (scrollable - the measurement) -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource PanelHi}" Padding="12,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="EVERY MACHINE, RANKED BY LEAD" Style="{StaticResource PanelHeader}" FontSize="11" />
                                    <TextBlock Text="{Binding TwistLead}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                                    <ItemsControl ItemsSource="{Binding Machines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock Text="{Binding DegText}" FontWeight="Bold" FontSize="12" Width="72"
                                                               DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{Binding Bar}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" FontSize="10"
                                                               Width="72" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <Border Height="5" Width="150" Background="{StaticResource Track}" CornerRadius="2.5" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                            <Border Width="{Binding BarWidth}" Height="5" Background="{Binding Bar}" CornerRadius="2.5" HorizontalAlignment="Left" />
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ THE GRAND ENGINE ============ -->
            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                <TextBlock Text="THE GRAND ENGINE  -  the whole grid as one giant motor" Style="{StaticResource PanelHeader}" Margin="2,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- shaft torque -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="SHAFT TORQUE" Style="{StaticResource PanelHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TorqueFtLb}" Style="{StaticResource Value}" />
                            </StackPanel>
                            <TextBlock Text="{Binding TorqueNative}" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TorqueCars}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- shaft horsepower -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource PanelHi}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="SHAFT HORSEPOWER" Style="{StaticResource PanelHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ShaftHp}" Style="{StaticResource Value}" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ShaftNative}" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ShaftCars}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- grid speed -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="GRID SPEED" Style="{StaticResource PanelHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding GridRpm}" Style="{StaticResource Value}" />
                            </StackPanel>
                            <TextBlock Text="every synchronous machine, locked in step" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding BladeTip}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ============ REGENERATIVE BRAKING ============ -->
            <StackPanel Grid.Row="3" Margin="0,12,0,4">
                <TextBlock Text="REGENERATIVE BRAKING  -  the spinning mass as an energy bank" Style="{StaticResource PanelHeader}" Margin="2,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- stored spin energy -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource PanelHi}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="STORED SPIN  -  if you regened every last joule" Style="{StaticResource PanelHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SpinKwh}" Style="{StaticResource Value}" Foreground="{StaticResource Green}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SpinNative}" Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,6" />
                            <TextBlock Text="{Binding SpinCars}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding SpinHomes}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding SpinKettles}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- live regen power from RoCoF -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="LIVE BRAKING POWER" Style="{StaticResource PanelHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding RegenHp}" Style="{StaticResource Value}" Foreground="{Binding RegenBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RegenDir}" FontSize="11" FontWeight="Bold" Foreground="{Binding RegenBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding RegenNote}" Style="{StaticResource Label}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="spinning down at " Style="{StaticResource Label}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RocofRpmS}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ============ THINGS YOU CAN HOLD ============ -->
            <StackPanel Grid.Row="4" Margin="0,12,0,4">
                <TextBlock Text="IN THINGS YOU CAN HOLD  -  the load, counted in household appliances" Style="{StaticResource PanelHeader}" Margin="2,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- demand -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="THE LOAD RIGHT NOW" Style="{StaticResource PanelHeader}" />
                            <TextBlock Text="{Binding DemandNative}" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding DemandKettles}" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding DemandHomes}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DemandShowers}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- losses -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource PanelHi}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="LOST IN THE WIRES" Style="{StaticResource PanelHeader}" />
                            <TextBlock Text="{Binding LossNative}" Style="{StaticResource Label}" FontSize="11" Margin="0,4,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding LossKettles}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <TextBlock Text="{Binding LossHomes}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
