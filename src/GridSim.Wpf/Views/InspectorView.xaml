<UserControl x:Class="GridSim.Wpf.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding Visibility}">
    <!-- full-tab backdrop; the card floats centre-right so the panel behind stays partly visible -->
    <Grid Background="#B8090D12">
        <Border Style="{StaticResource Card}" Background="#0E141B" BorderBrush="#2A3A4A" BorderThickness="1"
                CornerRadius="8" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Border Grid.Row="0" Background="#141C24" CornerRadius="8,8,0,0" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="&lt; back" Command="{Binding BackCommand}"
                                Visibility="{Binding BackVisibility}" Style="{StaticResource FlatBtn}" Margin="0,0,10,0" />
                        <Button DockPanel.Dock="Right" Content="x" Command="{Binding CloseCommand}"
                                Style="{StaticResource FlatBtn}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelHeader}" FontSize="15" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- combined / averaged stat tiles -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="12,12,12,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#11FFFFFF" CornerRadius="5" Margin="3" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" FontSize="8" />
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontWeight="Bold" FontSize="15" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- constituent rows -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,4,12,12">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowLinkBtn}" Padding="10,6" Margin="0,2" Command="{Binding Drill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Primary}" Foreground="{StaticResource Text}" FontSize="12" />
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Label}" FontSize="9" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                   Style="{StaticResource Value}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text=">" Foreground="#5A6B7A" FontSize="16" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding Chevron}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
