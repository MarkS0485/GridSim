<UserControl x:Class="GridSim.Wpf.Views.NesoRp1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:GridSim.Wpf.Visuals"
             xmlns:v="clr-namespace:GridSim.Wpf.Views">
    <Grid Margin="10" DataContext="{Binding NesoRp1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ title ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="NESO RP1  *  SITUATIONAL AWARENESS" Style="{StaticResource PanelHeader}" FontSize="13" />
                    <TextBlock Text="where am I now  *  where am I going  *  how long do I have"
                               Style="{StaticResource Label}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="{Binding PageVisibility}">
                    <TextBlock Text="LFDD RISK" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right" />
                    <Border Background="{Binding LfddBrush}" CornerRadius="4" Padding="12,3" Margin="0,2,0,0">
                        <TextBlock Text="{Binding LfddGrade}" Foreground="White" FontWeight="Bold" FontSize="13" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ N301 (LF3, Ruling R1): the page does not apply to a case whose nominal is not 50 Hz ============
             RP1 is a NESO GB 50 Hz product page. On such a case the body below is collapsed and this one-line reason
             (the same text as the web Rp1Tab) is shown instead; the view-model still computes every figure. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" VerticalAlignment="Top"
                Visibility="{Binding NotApplicableVisibility}">
            <TextBlock Text="{Binding NotApplicableReason}" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- ============ 5x5 body: LEFT | CENTRE (stability / narrative / market) | RIGHT ============ -->
        <Grid Grid.Row="1" Visibility="{Binding PageVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN : GENERATION & INERTIA ================= -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="GENERATION &amp; INERTIA" Style="{StaticResource PanelHeader}" />

                    <!-- three inertia gauges: total liquid vs petrol vs water (MIF fuel-gauge) -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,0">
                        <viz:Gauge Caption="GVA.s TOTAL" Unit="GVA.s" Height="120"
                                   ValueText="{Binding InertiaTotalText}" Value="{Binding InertiaTotalValue}"
                                   Minimum="0" Maximum="400" />
                        <viz:Gauge Caption="GVA.s(i)" Unit="intrinsic" Height="120"
                                   ValueText="{Binding InertiaIntrinsicText}" Value="{Binding InertiaIntrinsicValue}"
                                   Minimum="0" Maximum="400" RedTo="0.255" AmberTo="0.39" />
                        <viz:Gauge Caption="GVA.s(p)" Unit="market" Height="120"
                                   ValueText="{Binding InertiaProxyText}" Value="{Binding InertiaProxyValue}"
                                   Minimum="0" Maximum="400" />
                    </UniformGrid>
                    <TextBlock Grid.Row="1" Text="petrol vs water" Style="{StaticResource Label}" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" />

                    <!-- generation stack (per-fuel bars): output / headroom / inertia, synchronous vs converter -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DISPATCH STACK  *  output / headroom / inertia" Style="{StaticResource Label}" FontSize="9" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding GenStack}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowLinkBtn}" Padding="3,2" Margin="0,1"
                                                Command="{Binding DataContext.InspectFuelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Fuel}" ToolTip="Click to see the constituent units">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}"
                                                    VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="{Binding KindBrush}" CornerRadius="2" Padding="4,0" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Kind}" Foreground="#0B0F14" FontSize="8" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Fuel}" Foreground="{StaticResource Text}" FontSize="11" />
                                                </DockPanel>
                                                <ProgressBar Height="4" Margin="0,3,6,0" Minimum="0" Maximum="100"
                                                             Value="{Binding OutputPercent, Mode=OneWay}"
                                                             Foreground="{Binding Swatch}" Background="{StaticResource Track}" BorderThickness="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="82">
                                                <TextBlock Text="{Binding Output}" Style="{StaticResource Value}" FontSize="11" TextAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Headroom}" Style="{StaticResource Label}" FontSize="9" Foreground="#66808A" />
                                                    <TextBlock Text="  " FontSize="9" />
                                                    <TextBlock Text="{Binding Inertia}" Style="{StaticResource Label}" FontSize="9" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SYNCHRONOUS" Style="{StaticResource Label}" FontSize="9" />
                                <TextBlock Text="{Binding SynchronousGw}" Foreground="#2FD27F" FontWeight="Bold" FontSize="20" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CONVERTER" Style="{StaticResource Label}" FontSize="9" />
                                <TextBlock Text="{Binding ConverterGw}" Foreground="#8492A0" FontWeight="Bold" FontSize="20" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= CENTRE : STABILITY / NARRATIVE / MARKET ================= -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- TOP CENTRE : the stability calculation (2x2) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- purchased time : the hero gauge -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PURCHASED TIME" Style="{StaticResource PanelHeader}" />
                            <viz:Gauge Grid.Row="1" Caption="ride-through" Unit="s" Margin="0,4,0,0"
                                       ValueText="{Binding PurchasedText}" Value="{Binding PurchasedValue}"
                                       Minimum="0" Maximum="10" RedTo="0.2" AmberTo="0.5" />
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                <TextBlock Foreground="{Binding PurchasedBrush}" HorizontalAlignment="Center"
                                           FontWeight="Bold" FontSize="26" Text="{Binding PurchasedText}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="correlated cluster (not secured) " Style="{StaticResource Label}" FontSize="9" />
                                    <TextBlock Text="{Binding PurchasedDesign}" Style="{StaticResource Label}" FontSize="9" Foreground="#F3C13A" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- live credible loss -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="LIVE CREDIBLE LOSS" Style="{StaticResource PanelHeader}" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LargestUnit}" Style="{StaticResource Value}"
                                           FontSize="22" Foreground="{Binding UnitBrush}" />
                                <TextBlock Text="{Binding LargestUnitLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LargestGroup}" Style="{StaticResource Value}"
                                           FontSize="22" Foreground="{Binding GroupBrush}" />
                                <TextBlock Text="{Binding LargestGroupLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Height="1" Background="#22FFFFFF" Margin="0,8" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DesignBasis}" Style="{StaticResource Label}" Foreground="#F3C13A" />
                                <TextBlock Text="correlated cluster (not secured)" Style="{StaticResource Label}" />
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <!-- N040 (S3, October 2026): 1,800 MW is NOT superseded. NESO FRCR 2025 (docs/reference S052)
                                     s.4.1 p.10 and s.7.1 treat it as the FUTURE largest loss to be secured, so it is shown
                                     plainly (no strikethrough) with its source. -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Fiction}" Style="{StaticResource Label}" />
                                <TextBlock Text="future largest loss (FRCR 2025)" Style="{StaticResource Label}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- inertia by source (seconds) -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,5,5,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="INERTIA BY SOURCE  *  seconds" Style="{StaticResource PanelHeader}" />
                            <ItemsControl ItemsSource="{Binding InertiaBySource}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowLinkBtn}" Padding="3,1" Margin="0,1"
                                                Command="{Binding DataContext.InspectFuelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Fuel}" ToolTip="Click to see the constituent units">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2"
                                                    Background="{Binding Swatch}" Margin="0,0,6,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Seconds}" Style="{StaticResource Value}" FontSize="12" />
                                            <TextBlock Text="{Binding Fuel}" Style="{StaticResource Label}" />
                                        </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- stability trend -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="5,5,0,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- D-DOC-148: the trace holds the last FrequencyRiskPresenter.TraceCapacity (60) state FRAMES, one per solved
                                 frame, so its span in time depends on the step; it is labelled in frames, not minutes. -->
                            <TextBlock Grid.Row="0" Text="{Binding StabilityTrendTitle}" Style="{StaticResource PanelHeader}" />
                            <viz:Sparkline Grid.Row="1" Values="{Binding StabilityTrace}" Caption="PURCHASED TIME" Margin="0,6,0,0" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Text="dyn MIF " Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding DynamicMif}" Style="{StaticResource Value}" FontSize="12" />
                                <TextBlock Text="   RoCoF " Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding Rocof}" Style="{StaticResource Value}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- CENTRE STRIP : the system narrative (handover sentence) -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10" Padding="12,8"
                        Background="#141C24" BorderBrush="#2A3A4A" BorderThickness="1">
                    <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap" Foreground="#CFE0EA"
                               FontFamily="Consolas" FontSize="12" />
                </Border>

                <!-- BOTTOM CENTRE : market / BM / IC / LFDD (2x2) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- imbalance price + rolling chart -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,5,5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ImbalancePrice}" Style="{StaticResource Value}" FontSize="20" />
                                <TextBlock Text="IMBALANCE PRICE  *  GBP/MWh" Style="{StaticResource PanelHeader}" VerticalAlignment="Center" />
                            </DockPanel>
                            <viz:Sparkline Grid.Row="1" Values="{Binding PriceTrace}" Caption="STREAMED" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <!-- BM stability delta -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="BM STABILITY DELTA" Style="{StaticResource PanelHeader}" />
                            <TextBlock Grid.Row="1" Text="{Binding BmSummary}" Style="{StaticResource Label}" FontSize="10" Margin="0,2,0,4" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BmDelta}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowLinkBtn}" Padding="3,1" Margin="0,1"
                                                    Command="{Binding DataContext.InspectBmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Click for the acceptance detail">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding DirBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Unit}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{Binding DirBrush}"
                                                           FontSize="10" VerticalAlignment="Center" Margin="6,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Mw}" Style="{StaticResource Value}" FontSize="11"
                                                           VerticalAlignment="Center" Width="56" TextAlignment="Right" />
                                            </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- interconnector summary -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,5,5,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="INTERCONNECTORS  *  o correlated trip" Style="{StaticResource PanelHeader}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding Interconnectors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowLinkBtn}" Padding="3,1" Margin="0,1"
                                                    Command="{Binding DataContext.InspectIcCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Click for flow + correlated-trip group">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding FlagBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Flow}" Foreground="{Binding FlowBrush}"
                                                           FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- LFDD risk indicator -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="5,5,0,0" Padding="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="LFDD RISK" Style="{StaticResource PanelHeader}" HorizontalAlignment="Center" />
                            <Border Background="{Binding LfddBrush}" CornerRadius="8" Padding="24,10" Margin="0,10,0,0">
                                <TextBlock Text="{Binding LfddGrade}" Foreground="White" FontWeight="Bold" FontSize="24" />
                            </Border>
                            <TextBlock Text="{Binding PurchasedText}" Foreground="{Binding PurchasedBrush}"
                                       FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="purchased time" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= RIGHT COLUMN : NETWORK CONSTRAINT & COHERENCE COST ================= -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.2*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="NETWORK CONSTRAINT &amp; COST" Style="{StaticResource PanelHeader}" />

                    <!-- boundary transfers vs limit + trend -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding BoundaryNote}" Style="{StaticResource Label}" FontSize="9"
                                       TextWrapping="Wrap" Foreground="#66808A" />
                            <ItemsControl ItemsSource="{Binding BoundaryBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="11" />
                                                <ProgressBar Height="4" Margin="0,3,8,0" Minimum="0" Maximum="120"
                                                             Value="{Binding LoadingPercent, Mode=OneWay}"
                                                             Foreground="{Binding LoadingBrush}" Background="{StaticResource Track}" BorderThickness="0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Loading}" Foreground="{Binding LoadingBrush}"
                                                       FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Trend}" Foreground="{Binding TrendBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="COHERENCE COST  *  GBP/h by constraint" Style="{StaticResource Label}"
                               FontSize="9" Margin="0,8,0,0" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding ConstraintCosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding BindingBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CostPerHour}" Style="{StaticResource Value}"
                                                   FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- drill-down inspector overlay (spans the whole tab) -->
        <v:InspectorView Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Inspector}" />
    </Grid>
</UserControl>
