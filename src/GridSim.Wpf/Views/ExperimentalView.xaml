<UserControl x:Class="GridSim.Wpf.Views.ExperimentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" DataContext="{Binding Experimental}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ gate verdict ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="PHYSICS CONFORMANCE" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" Margin="0,4,0,12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Gate}" Foreground="{Binding GateBrush}" FontWeight="Bold" FontSize="20" />
            </StackPanel>
        </Border>

        <!-- ============ experimental attributions ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="EXPERIMENTAL MODELS  *  opt-in, off the validated path" Style="{StaticResource PanelHeader}" />
                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,44,8">
                        <TextBlock Text="RECIPROCITY (Y = Y^T)" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Reciprocity}" Style="{StaticResource Value}" FontSize="15" />
                    </StackPanel>
                    <StackPanel Margin="0,0,44,8">
                        <TextBlock Text="CONTINUUM WAVE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Wave}" Style="{StaticResource Value}" FontSize="15" />
                        <TextBlock Text="{Binding WaveSplit}" Foreground="#8A97A6" FontSize="12" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                    <StackPanel Margin="0,0,44,8">
                        <TextBlock Text="CARBON INTENSITY" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Carbon}" Style="{StaticResource Value}" FontSize="15" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============ law table + traced flows ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PHYSICAL-LAW AUDIT  *  independent per-branch recompute" Style="{StaticResource PanelHeader}" />
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="LAW" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="3" Text="RESIDUAL" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="4" Text="GATE" Style="{StaticResource Label}" />
                        </Grid>
                        <Border Height="1" Background="#1E2733" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Laws}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="#8A97A6" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E6EDF3" />
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding Residual}" Foreground="#C9D4DF" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Gated}" Foreground="#E0A05A" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Unit}" Foreground="#5C6773" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="POWER-FLOW TRACE  *  Bialek proportional sharing (top generator -> load)" Style="{StaticResource PanelHeader}" />
                        <TextBlock Text="{Binding TraceStatus}" Foreground="#8A97A6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding TopFlows}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding From}" Foreground="#3FA9F5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="->" Foreground="#5C6773" />
                                        <TextBlock Grid.Column="2" Text="{Binding To}" Foreground="#E6EDF3" />
                                        <TextBlock Grid.Column="3" Text="{Binding Mw}" Foreground="#C9D4DF" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ provenance ============ -->
        <TextBlock Grid.Row="3" Text="{Binding Provenance}" Foreground="#8A97A6" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
