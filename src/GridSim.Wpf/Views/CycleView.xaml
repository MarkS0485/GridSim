<UserControl x:Class="GridSim.Wpf.Views.CycleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" DataContext="{Binding Cycle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ hero: High-tier guarantee + utilization ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Hero}" Foreground="{Binding HeroBrush}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="UTILIZATION" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Util}" Foreground="{Binding HeroBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ summary + jobs ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- summary -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,6,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelHeader}">
                        <Run Text="CYCLE " /><Run Text="{Binding CycleIndex}" /><Run Text="  -  budget accounting" />
                    </TextBlock>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding BaseSolve}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
                        <TextBlock Text="Base solve (single core)" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Wall}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
                        <TextBlock Text="Fan-out wall time" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Compute}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
                        <TextBlock Text="Compute spent (core-s)" Style="{StaticResource Label}" />
                    </DockPanel>

                    <Border Height="1" Background="#1E2733" Margin="0,12" />

                    <DockPanel Margin="0,0,0,0">
                        <TextBlock Text="{Binding High}" DockPanel.Dock="Right" Foreground="{Binding HighBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="High tier" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Low}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
                        <TextBlock Text="Low tier (done / admitted / deferred)" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Cancelled}" DockPanel.Dock="Right" Foreground="#F3C13A" FontWeight="SemiBold" />
                        <TextBlock Text="Low cancelled at deadline" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Backlog}" DockPanel.Dock="Right" Foreground="#E6EDF3" FontWeight="SemiBold" />
                        <TextBlock Text="Backlog depth" Style="{StaticResource Label}" />
                    </DockPanel>

                    <Border Height="1" Background="#1E2733" Margin="0,12" />

                    <DockPanel Margin="0,0,0,0">
                        <TextBlock Text="{Binding Coverage}" DockPanel.Dock="Right" Foreground="{Binding CoverageBrush}" FontWeight="SemiBold" />
                        <!-- D-DOC-144: cumulative since the model was loaded (it never falls), so not "rolling". -->
                        <TextBlock Text="N-1 shards covered since load" Style="{StaticResource Label}" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Worst}" DockPanel.Dock="Right" Foreground="{Binding WorstBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Worst contingency seen" Style="{StaticResource Label}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- jobs -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="6,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="JOBS THIS CYCLE  -  HIGH FIRST, HEAVIEST FIRST" Style="{StaticResource PanelHeader}" />
                    <ItemsControl ItemsSource="{Binding Jobs}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Priority}" Foreground="{Binding PriorityBrush}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#C9D4DF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Outcome}" Foreground="{Binding OutcomeBrush}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ explainer ============ -->
        <TextBlock Grid.Row="2" Margin="2,10,2,0" Foreground="#8A97A6" FontSize="12" TextWrapping="Wrap"
                   Text="The Newton-Raphson base solve is single-core; once it converges its immutable frame is shared to every downstream analysis and run across a worker pool. High jobs (hot N-1, harmonics, watch list) complete every cycle; Low jobs (rotating N-1 shards, RoCoF, conformance) run best-effort within the compute budget (workers x window) and rotate to full N-1 coverage over several cycles. Compute budget is measured in core-milliseconds, so it scales with core count." />
    </Grid>
</UserControl>
