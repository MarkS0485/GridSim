<UserControl x:Class="GridSim.Wpf.Views.OperatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:GridSim.Wpf.Visuals">
    <Grid Margin="10" DataContext="{Binding Operator}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ title + warning banner ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="OPERATOR  SYSTEM CONTROL ROOM" Style="{StaticResource PanelHeader}" FontSize="13" />
                    <TextBlock Text="balancing, constraints and security  -  streamed from the GDA lake"
                               Style="{StaticResource Label}" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{Binding WarningBrush}" CornerRadius="4" Padding="10,4"
                        Visibility="{Binding WarningVisible}">
                    <TextBlock Text="{Binding WarningBanner}" Foreground="White" FontWeight="Bold" FontSize="11" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ console body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: headline + boundary transfers ===== -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                    <UniformGrid Columns="3">
                        <StackPanel Margin="4">
                            <TextBlock Text="FREQUENCY" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Frequency}" Style="{StaticResource Value}" Foreground="{Binding FrequencyBrush}" />
                            <TextBlock Text="Hz" Style="{StaticResource Unit}" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="RoCoF" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Rocof}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="INERTIA" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Inertia}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="DEMAND" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Demand}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="GENERATION" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Generation}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="LOSSES" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Losses}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="LARGEST LOSS  *  live N-1" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LargestLoss}" Style="{StaticResource Value}" FontSize="18" />
                            <TextBlock Text="{Binding DesignBasisLoss}" Style="{StaticResource Label}" FontSize="9" Foreground="#F3C13A" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="DERATED MARGIN" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding DeratedMargin}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="RESERVE" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ReserveMw}" Style="{StaticResource Value}" FontSize="18" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelHi}" Padding="12,8"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                            <TextBlock Text="TRANSMISSION BOUNDARIES  -  transfer vs limit" Style="{StaticResource PanelHeader}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Boundaries}" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.9*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="11" />
                                            <ProgressBar Height="4" Margin="0,3,8,0" Minimum="0" Maximum="120"
                                                         Value="{Binding LoadingPercent, Mode=OneWay}"
                                                         Foreground="{Binding LoadingBrush}" Background="{StaticResource Track}"
                                                         BorderThickness="0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Flow}" Style="{StaticResource Label}"
                                                   FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Limit}" Style="{StaticResource Label}"
                                                   FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Loading}" Foreground="{Binding LoadingBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ===== CENTRE: generation stack + synchronous split ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelHi}" Padding="12,8"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                        <TextBlock Text="GENERATION STACK" Style="{StaticResource PanelHeader}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="SYNCHRONOUS" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SynchronousGw}" Style="{StaticResource Value}" FontSize="18"
                                           Foreground="{StaticResource Green}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="CONVERTER" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding ConverterGw}" Style="{StaticResource Value}" FontSize="18"
                                           Foreground="{StaticResource Accent}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Fuel}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}"
                                            VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Fuel}" Foreground="{StaticResource Text}" FontSize="11" />
                                        <ProgressBar Height="4" Margin="0,3,8,0" Minimum="0" Maximum="100"
                                                     Value="{Binding SharePercent, Mode=OneWay}"
                                                     Foreground="{Binding Swatch}" Background="{StaticResource Track}" BorderThickness="0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Mw}" Style="{StaticResource Label}"
                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Share}" Foreground="{StaticResource Text}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Width="42"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ===== RIGHT: balancing mechanism + constraints + warnings ===== -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelHi}" Padding="12,8"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                            <TextBlock Text="BALANCING MECHANISM  -  live acceptances" Style="{StaticResource PanelHeader}" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BalancingActions}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Unit}" Foreground="{StaticResource Text}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="{Binding KindBrush}" CornerRadius="3" Padding="5,1" Margin="4,0">
                                                <TextBlock Text="{Binding Kind}" Foreground="Black" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Mw}" Style="{StaticResource Label}"
                                                       FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Price}" Foreground="{StaticResource Text}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelHi}" Padding="12,8"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                            <TextBlock Text="ACTIVE CONSTRAINTS" Style="{StaticResource PanelHeader}" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Constraints}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Text}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding BindingBrush}"
                                                     VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding CostGbp}" Style="{StaticResource Label}"
                                                       FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
