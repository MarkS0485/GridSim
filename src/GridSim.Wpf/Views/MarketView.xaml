<UserControl x:Class="GridSim.Wpf.Views.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:GridSim.Wpf.Visuals">
    <Grid Margin="10" DataContext="{Binding Market}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ title ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MARKET  WHOLESALE &amp; BALANCING" Style="{StaticResource PanelHeader}" FontSize="13" />
                <TextBlock Text="prices, imbalance, interconnectors and carbon  -  streamed from the GDA lake"
                           Style="{StaticResource Label}" FontSize="10" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ headline price tiles ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <UniformGrid Columns="6">
                <StackPanel Margin="6">
                    <TextBlock Text="IMBALANCE PRICE" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ImbalancePrice}" Style="{StaticResource Value}" Foreground="{Binding ImbalanceBrush}" />
                    <TextBlock Text="GBP/MWh" Style="{StaticResource Unit}" />
                </StackPanel>
                <StackPanel Margin="6">
                    <TextBlock Text="MARKET INDEX" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding MarketIndex}" Style="{StaticResource Value}" FontSize="20" />
                    <TextBlock Text="APX / N2EX" Style="{StaticResource Unit}" />
                </StackPanel>
                <StackPanel Margin="6">
                    <TextBlock Text="BSUoS" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Bsuos}" Style="{StaticResource Value}" FontSize="20" />
                    <TextBlock Text="GBP/MWh" Style="{StaticResource Unit}" />
                </StackPanel>
                <StackPanel Margin="6">
                    <TextBlock Text="CONSTRAINT COST" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ConstraintCost}" Style="{StaticResource Value}" FontSize="20" />
                    <TextBlock Text="thermal, today" Style="{StaticResource Unit}" />
                </StackPanel>
                <StackPanel Margin="6">
                    <TextBlock Text="CARBON" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Carbon}" Style="{StaticResource Value}" FontSize="20" Foreground="{Binding CarbonBrush}" />
                    <TextBlock Text="{Binding RenewableShare, StringFormat='renewable {0}'}" Style="{StaticResource Unit}" />
                </StackPanel>
                <StackPanel Margin="6">
                    <TextBlock Text="DEMAND" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Demand}" Style="{StaticResource Value}" FontSize="20" />
                    <TextBlock Text="{Binding DemandForecast, StringFormat='fcast {0}'}" Style="{StaticResource Unit}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ============ body: price trace + interconnectors ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="IMBALANCE PRICE  -  recent settlement periods (GBP/MWh)"
                               Style="{StaticResource PanelHeader}" Margin="0,0,0,8" />
                    <viz:Sparkline Values="{Binding PriceTrace}" Caption="STREAMED FROM LAKE" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelHi}" Padding="12,8"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                        <TextBlock Text="INTERCONNECTORS" Style="{StaticResource PanelHeader}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Interconnectors}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Text}"
                                               FontSize="11" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{Binding FlowBrush}" CornerRadius="3" Padding="5,1" Margin="4,0">
                                        <TextBlock Text="{Binding Direction}" Foreground="Black" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Flow}" Foreground="{Binding FlowBrush}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
