<Project Sdk="Microsoft.NET.Sdk">

  <!-- GridSim.App.Desktop (UI programme, Phase 0.4): the desktop head of the cross-platform app. It only starts
       GridSim.App's App on Windows, Linux or macOS through Avalonia.Desktop's platform detection. Plain net10.0 with no
       RuntimeIdentifier here, so it builds on every CI leg; the per-RID publish (win-x64/arm64, osx-arm64/x64,
       linux-x64/arm64) comes with the desktop release work (Phase 2).
       It must never reference GridSim.Wpf, GridSim.Web, GridSim.Gda or GridSim.Gpu (AppProjectReferenceTests).
       Version: set once for every project in Directory.Build.props (F02); do not add one here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GridSim.App.Desktop</RootNamespace>
    <AssemblyName>GridSim.App.Desktop</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Avalonia's desktop backends do not use the built-in COM interop; leaving it off keeps the app trimmable. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Pinned exactly, the same version as GridSim.App's Avalonia packages; listed in THIRD-PARTY-NOTICES.md with every
       transitive dependency (the platform backends, SkiaSharp and HarfBuzzSharp native assets). -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GridSim.App\GridSim.App.csproj" />
  </ItemGroup>

  <!-- The bundled cases ship next to the app, exactly as the CLI ships them (GitHub issue #6: the app archives had no
       data/ folder, so the case list showed only the cases built into the engine). ModelCatalog, SimHost and
       CaseTemplates look for <executable folder>/data. The item set is the CLI's, item for item, so the two downloads
       carry the same bundled data and the same manifest (data/bundled.sha256: a network is bundled only when its files
       match it); DesktopAppDataPackagingTests pins the match. -->
  <ItemGroup>
    <Content Include="..\..\data\**\*.json" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*.csv" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\matpower\**\*.m" Link="data\matpower\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\bundled.sha256" Link="data\bundled.sha256" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The licences and attribution files of the bundled third-party data travel with the data (THIRD-PARTY-NOTICES.md
       lists every source), as in the CLI. The local, uncommitted reference inbox is never shipped. -->
  <ItemGroup>
    <Content Include="..\..\data\**\LICENSE*.txt;..\..\data\**\ATTRIBUTION.txt;..\..\data\**\README.md;..\..\data\**\MODEL_CARD.md"
             Exclude="..\..\data\reference-inbox\**" Link="data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The JSON schemas the build understands, as in the CLI, so a user of the app download can validate a case file. -->
  <ItemGroup>
    <Content Include="..\..\schemas\**\*.json" Link="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The licences of the two fonts compiled into GridSim.App (SIL Open Font License 1.1 requires the licence to travel
       with the fonts). -->
  <ItemGroup>
    <Content Include="..\GridSim.App\Fonts\OFL-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- F07: the licence and the third-party notices ship with every build and publish. -->
  <ItemGroup>
    <Content Include="..\..\LICENSE.md" Link="LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
