<Project Sdk="Microsoft.NET.Sdk">

  <!-- GridSim.Scripting (RC4): the scripting layer. A verb-first, line-oriented script language (grammar version 1,
       files end in .gss) that drives GridSim.Core the way a person at a console would: LOAD, SOLVE, TRIP, STEP, REPORT,
       EXPORT. It references Core only and changes nothing in it; the console front end is GridSim.Scripting.Console.
       Version: set once for every project in Directory.Build.props (F02); do not add one here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GridSim.Scripting</RootNamespace>
    <AssemblyName>GridSim.Scripting</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GridSim.Core\GridSim.Core.csproj" />
  </ItemGroup>

</Project>
