<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0. The GDA ingestion layer: reads the read-only /gda data lake
         (NESO + DNO LTDS) at runtime and materialises a GridSim.Core GridModel.
         It embeds NO data - only the schema mapping. The raw grid data stays
         on the authorised machine; generated models are git-ignored. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GridSim.Gda</RootNamespace>
    <AssemblyName>GridSim.Gda</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <!-- F07: the old NU1903 suppression (a Snappier advisory reached through Parquet.Net)
         is removed. `dotnet list package vulnerable include-transitive` reported no
         vulnerable package on 2026-10-03 (Snappier is now 1.3.1), so the suppression
         only hid future advisories. NuGet audit warnings are errors here
         (TreatWarningsAsErrors), and CI runs the same vulnerable-package gate. -->
    <!-- F25 (Ruling R1, 2026-10-04): GridSim.Gda is NOT a release artefact. GDA is a model the author uses, not
         something that ships, so there is no GridSim.Gda NuGet package: `dotnet pack` skips this project and
         publish.yml packs GridSim.Core only. The assembly still ships inside the CLI, because the `gda` verbs stay
         there (they need a GDA data lake). The package metadata below is kept so the decision can be reversed in
         one line. -->
    <IsPackable>false</IsPackable>
    <PackageId>GridSim.Gda</PackageId>
    <!-- Version: set once for every project in Directory.Build.props (F02); do not add one here. -->
    <Authors>MarkS0485</Authors>
    <Description>GDA ingestion for GridSim: maps the GB grid-data-archive schemas (NESO TEC/ETYS, DNO LTDS tabular model) onto a GridSim.Core GridModel. Schema mapping only - no grid data is embedded.</Description>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (C) 2026 MarkS0485</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- F07: Gda brings Parquet.Net and its compression libraries; their notices travel with the package. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GridSim.Core\GridSim.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-managed Parquet reader: lets the converter ingest the parquet-format
         GDA datasets (several DNOs publish their LTDS only as parquet). -->
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

</Project>
