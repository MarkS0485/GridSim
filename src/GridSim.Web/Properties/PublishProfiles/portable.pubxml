<?xml version="1.0" encoding="utf-8"?>
<!-- F04: release publish profile for the GridSim web app (Blazor Server + REST / WebSocket API).

     Use:  dotnet publish src/GridSim.Web -c Release -p:PublishProfile=portable
     Out:  artifacts/publish/gridsim-web/   (artifacts/ is ignored by source control)
     Run:  dotnet GridSim.Web.dll           (needs the ASP.NET Core 10 runtime on the host)

     Framework-dependent and portable (no runtime identifier): the same folder runs on Windows, Linux and macOS
     wherever the ASP.NET Core runtime is installed, and it is what the container image (Dockerfile) is built from.
     A web app is deployed as a folder of files (wwwroot static assets, the bundled data/ models, appsettings*.json),
     so single-file packaging would bring nothing. Trimming and ReadyToRun are off for the same reasons as the CLI
     profiles (reflection-heavy JSON; one verified code-generation path for the numerics).

     Deployment settings (port, single sign-on, data protection keys, replay-only mode) are NOT in this profile:
     they come from appsettings.Production.json and environment variables; see docs/developer/deploy/README.md. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\gridsim-web\</PublishDir>
  </PropertyGroup>
</Project>
